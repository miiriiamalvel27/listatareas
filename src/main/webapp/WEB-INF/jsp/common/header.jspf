<!DOCTYPE html>
<html>
<head>

    <meta charset="UTF-8">

    <title>Gestión de Tareas</title>

    <link
        href="${pageContext.request.contextPath}/webjars/bootstrap/3.3.6/css/bootstrap.min.css"
        rel="stylesheet">

    <style>

        body {
            padding-bottom: 120px;
        }

        .footer {
            position: fixed;
            left: 0;
            bottom: 0;
            width: 100%;
            background-color: black;
            color: white;
            height: 100px;
            text-align: center;
        }

        .footer a {
            color: #337ab7;
        }

    </style>

